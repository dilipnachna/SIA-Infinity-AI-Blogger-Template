{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dilipnachna/SIA-Infinity-AI-Blogger-Template/blob/main/schemas/sia-config.schema.json",
  "title": "SIA-Infinity Blogger Intelligence Config v0.1",
  "type": "object",
  "required": [
    "blog_url",
    "output",
    "max_posts",
    "entity_min_occurrences",
    "related_display_limit",
    "related_max_k",
    "related_min_similarity",
    "compact",
    "aliases"
  ],
  "properties": {
    "blog_url": {"type": "string", "format": "uri"},
    "output": {"type": "string", "minLength": 1},
    "max_posts": {"type": "integer", "minimum": 1, "maximum": 10000},
    "entity_min_occurrences": {"type": "integer", "minimum": 2, "maximum": 1000},
    "related_display_limit": {"type": "integer", "minimum": 1, "maximum": 12},
    "related_max_k": {"type": "integer", "minimum": 3, "maximum": 55},
    "related_min_similarity": {"type": "number", "minimum": 0, "maximum": 100},
    "related_limit": {"type": "integer", "minimum": 1, "description": "Legacy v0.1 key; no longer caps adaptive recall."},
    "related_min_score": {"type": "number", "minimum": 0, "maximum": 100, "description": "Legacy v0.1 alias for related_min_similarity."},
    "compact": {"type": "boolean"},
    "aliases": {
      "type": "object",
      "required": ["content_types", "facets", "entities"],
      "properties": {
        "content_types": {"type": "object"},
        "facets": {"type": "object"},
        "entities": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
